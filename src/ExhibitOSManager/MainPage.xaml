<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ExhibitOSManager.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ExhibitOSManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="32" MaxWidth="900" HorizontalAlignment="Stretch">
            
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="ExhibitOS" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="Unattended Windows Artwork PC Manager" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Safety Banner -->
            <InfoBar x:Name="SafetyBanner"
                     IsOpen="True"
                     Severity="Informational"
                     IsClosable="False"
                     Title="Development PC Mode (Safety Active)"
                     Message="System provisioning changes, user account creation, and registry modifications are simulated (dry-run). The host development machine is protected." />

            <!-- Main Mode Container -->
            <!-- SECTION A: Setup Wizard -->
            <StackPanel x:Name="WizardPanel" Spacing="20" Visibility="Visible">

                <!-- Step Tabs / Navigation -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                    <Button x:Name="StepBtn0" Content="1. Artwork" Click="OnStepBtnClick" Tag="0" />
                    <Button x:Name="StepBtn1" Content="2. Schedule" Click="OnStepBtnClick" Tag="1" />
                    <Button x:Name="StepBtn2" Content="3. Display &amp; Sound" Click="OnStepBtnClick" Tag="2" />
                    <Button x:Name="StepBtn3" Content="4. Test" Click="OnStepBtnClick" Tag="3" />
                    <Button x:Name="StepBtn4" Content="5. Configure" Click="OnStepBtnClick" Tag="4" />
                </StackPanel>

                <!-- STEP 1: Artwork -->
                <StackPanel x:Name="Step1Panel" Spacing="16">
                    <TextBlock Text="Step 1 — Choose Artwork Type" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Select what this computer will present to visitors during exhibition hours." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <RadioButtons x:Name="ArtworkTypeRadios" SelectionChanged="OnArtworkTypeSelectionChanged">
                        <RadioButton Content="Video Folder (Continuous fullscreen looped playback via mpv)" Tag="VideoFolder" IsChecked="True" />
                        <RadioButton Content="Web Artwork (Static HTML or Node.js backend via Microsoft Edge kiosk)" Tag="StaticWeb" />
                        <RadioButton Content="Application (Interactive executable, Unity/Unreal build, TouchDesigner)" Tag="Application" />
                    </RadioButtons>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Artwork Directory" FontWeight="SemiBold" />
                            <TextBlock x:Name="ArtworkDirectoryPathText" Text="C:\ExhibitOS\artwork" FontFamily="Consolas" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Open Folder in Explorer" Click="OnOpenFolderClick" />
                                <Button Content="Inspect Folder" Click="OnInspectFolderClick" />
                            </StackPanel>

                            <StackPanel x:Name="InspectionFeedbackPanel" Spacing="4" Margin="0,8,0,0">
                                <TextBlock x:Name="InspectionFeedbackText" Text="Click 'Inspect Folder' to verify artwork files." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="Next: Configure Schedule →" Click="OnNextStepClick" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!-- STEP 2: Exhibition Schedule -->
                <StackPanel x:Name="Step2Panel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Step 2 — Exhibition Schedule &amp; Power" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Define operational hours and daily power automation." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Opening Time" FontWeight="SemiBold" />
                            <TextBox x:Name="OpeningTimeBox" Text="07:00" PlaceholderText="HH:mm" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Closing Time" FontWeight="SemiBold" />
                            <TextBox x:Name="ClosingTimeBox" Text="20:00" PlaceholderText="HH:mm" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Morning Reboot Time" FontWeight="SemiBold" />
                            <TextBox x:Name="MorningRebootBox" Text="06:45" PlaceholderText="HH:mm" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TimeZoneNoticeText" Text="Schedule times use this PC's timezone: UTC" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontStyle="Italic" />

                    <TextBlock Text="Overnight Power Policy" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <RadioButtons x:Name="OvernightPowerRadios">
                        <RadioButton Content="Sleep with Wake Timers (Default — wakes before morning reboot; missed-reboot fallback)" Tag="SleepWithWakeTimers" IsChecked="True" />
                        <RadioButton Content="Shutdown (Clean shutdown at closing; manual power-on in morning)" Tag="Shutdown" />
                        <RadioButton Content="Idle (Stay powered overnight; turn off display signal; clean morning reboot)" Tag="Idle" />
                    </RadioButtons>

                    <TextBlock Text="Networking Mode" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <RadioButtons x:Name="NetworkingModeRadios">
                        <RadioButton Content="Offline Exhibition (Default — blocks all network except localhost 127.0.0.1)" Tag="OfflineExhibition" IsChecked="True" />
                        <RadioButton Content="Local Network Only (Subnet &amp; LAN allowed for sensors/OSC; no internet)" Tag="LocalNetworkOnly" />
                        <RadioButton Content="Internet Enabled (Full internet connectivity for live web works)" Tag="InternetEnabled" />
                    </RadioButtons>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Content="← Back" Click="OnPrevStepClick" />
                        <Button Content="Next: Display &amp; Sound →" Click="OnNextStepClick" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- STEP 3: Display & Sound -->
                <StackPanel x:Name="Step3Panel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Step 3 — Display &amp; Sound" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Hardware routing and display presentation during exhibition." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Audio Output Endpoint" FontWeight="SemiBold" />
                        <ComboBox x:Name="AudioDevicesCombo" HorizontalAlignment="Stretch" PlaceholderText="Select audio output device" />
                        <TextBlock Text="Locking audio to a specific device prevents silent reboot failure." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <CheckBox x:Name="HideCursorCheck" Content="Hide mouse cursor during playback" IsChecked="True" />

                    <TextBlock Text="Overnight Display Behavior" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <RadioButtons x:Name="OvernightDisplayRadios">
                        <RadioButton Content="Signal Off (DPMS — cuts video signal via power management)" Tag="SignalOff" IsChecked="True" />
                        <RadioButton Content="Blackout Screen (Keeps video signal active with pure black window — prevents projector 'No Signal' dialogs)" Tag="BlackoutScreen" />
                    </RadioButtons>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Content="← Back" Click="OnPrevStepClick" />
                        <Button Content="Next: Test Artwork →" Click="OnNextStepClick" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- STEP 4: Test -->
                <StackPanel x:Name="Step4Panel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Step 4 — Test Artwork" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Verify your artwork launches and renders correctly before committing system settings." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Launch / Test Artwork" Click="OnTestArtworkClick" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Stop Test" Click="OnStopTestArtworkClick" />
                            </StackPanel>
                            <TextBlock x:Name="TestStatusText" Text="Click 'Launch / Test Artwork' to verify playback." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Content="← Back" Click="OnPrevStepClick" />
                        <Button Content="Next: Summary &amp; Configure →" Click="OnNextStepClick" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- STEP 5: Configure -->
                <StackPanel x:Name="Step5Panel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Step 5 — Summary &amp; Exhibition Provisioning" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Review the configuration summary and apply exhibition provisioning." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="SummaryArtworkText" Text="Artwork: Video Folder" FontWeight="SemiBold" />
                            <TextBlock x:Name="SummaryScheduleText" Text="Schedule: 07:00 – 20:00 (Reboot 06:45)" />
                            <TextBlock x:Name="SummaryPowerText" Text="Overnight: Sleep with wake timers" />
                            <TextBlock x:Name="SummaryNetworkText" Text="Network: Offline Exhibition" />
                            <TextBlock x:Name="SummaryAudioText" Text="Audio: Default Audio Device" />
                        </StackPanel>
                    </Border>

                    <Button Content="Configure This PC for Exhibition" Click="OnConfigurePcClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />

                    <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Provisioning Log / Results" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProvisioningLogText" Text="Ready to configure." FontFamily="Consolas" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Content="← Back" Click="OnPrevStepClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- SECTION B: Maintenance Dashboard -->
            <StackPanel x:Name="DashboardPanel" Spacing="20" Visibility="Collapsed">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="●" Foreground="ForestGreen" FontSize="20" />
                            <TextBlock Text="READY FOR EXHIBITION" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock x:Name="DashArtworkText" Text="Artwork: Bergen Rain" />
                            <TextBlock x:Name="DashScheduleText" Text="Schedule: 07:00 – 20:00" />
                            <TextBlock x:Name="DashPowerText" Text="Overnight: Sleep (Missed-reboot fallback active)" />
                            <TextBlock x:Name="DashNetworkText" Text="Network: Offline Exhibition" />
                            <TextBlock x:Name="DashAudioText" Text="Audio: Line Out" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Launch / Test Artwork" Click="OnTestArtworkClick" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Stop Artwork" Click="OnStopTestArtworkClick" />
                            <Button Content="Run System Diagnostic" Click="OnRunDiagnosticClick" />
                        </StackPanel>

                        <TextBlock x:Name="DiagnosticResultsText" Text="" FontFamily="Consolas" TextWrapping="Wrap" Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                            <Button Content="Edit Configuration" Click="OnEditConfigClick" />
                            <Button Content="Restore PC to Normal Use" Click="OnRestorePcClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
